{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Inspired by astral-sh/uv, biomejs/biome and PostHog: pinned digests, a release age floor, grouped minor updates.
  extends: ['config:best-practices', ':semanticCommits', 'schedule:weekly'],
  timezone: 'Europe/Paris',
  labels: ['dependencies'],
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  // A new release waits three days before we take it: most compromised packages are pulled within hours.
  minimumReleaseAge: '3 days',
  lockFileMaintenance: { enabled: true, schedule: ['before 6am on monday'] },
  packageRules: [
    {
      description: 'GitHub Actions: pinned by commit, one pull request',
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      pinDigests: true,
    },
    {
      description: 'Minor and patch updates: one pull request per week',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      matchManagers: ['!github-actions'],
      groupName: 'non-major dependencies',
    },
    {
      description: 'One pull request per third-party image for the chart and the Compose stack, so they never drift',
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/library/postgres', 'postgres', 'library/postgres', 'docker.io/boxyhq/jackson', 'boxyhq/jackson'],
      groupName: 'third-party images (chart and Compose)',
    },
    {
      description: 'The digest-pinned third-party images belong to the regex manager below, not to the Helm values one',
      matchManagers: ['helm-values'],
      matchDepNames: ['docker.io/library/postgres', 'docker.io/boxyhq/jackson', 'docker.io/curlimages/curl'],
      enabled: false,
    },
  ],
  // The chart's third-party images are pinned by digest in values.yaml (docs/images.md): move the tag and the digest
  // together. The Helm values manager reads `tag` but not a separate `digest` key.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^charts/ostrom/values\\.yaml$/'],
      matchStrings: [
        'repository: (?<depName>docker\\.io/[^\\s]+)\\s+tag: "(?<currentValue>[^"]+)"\\s+digest: "(?<currentDigest>sha256:[a-f0-9]{64})"',
        'image: (?<depName>docker\\.io/[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  vulnerabilityAlerts: { labels: ['security'], minimumReleaseAge: null, schedule: ['at any time'] },
}
