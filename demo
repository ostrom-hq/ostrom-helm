#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Ostrom whole on this computer, in one command (macOS with Docker Desktop, or Linux with Docker):
#   ./demo up        checks the machine, takes main's images, starts everything, prints the addresses and sign-in
#   ./demo bootstrap the first owner's one-time setup link (the instance is invite-only)
#   ./demo journey   plays the customer's journey against it (Node 22+), report in compose/demo-report.md
#   ./demo down      removes everything it created
# The same as compose/demo/demo.sh, which says more: see compose/demo/README.md.
exec "$(dirname "$0")/compose/demo/demo.sh" "$@"
