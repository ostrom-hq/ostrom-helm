{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ostrom chart values",
  "description": "Unknown top-level keys are refused (a typo would silently keep a default). The security contexts cannot be weakened below the Pod Security Standard `restricted` and a read-only root filesystem (AUDIT-SECU-HELM-2 M5).",
  "type": "object",
  "required": [
    "podSecurityContext",
    "containerSecurityContext"
  ],
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imageTag": {
          "type": [
            "string",
            "number"
          ]
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "urls": {
          "type": "object",
          "properties": {
            "api": {
              "type": "string",
              "pattern": "^https?://"
            },
            "app": {
              "type": "string",
              "pattern": "^https?://"
            },
            "site": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "server": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$",
              "description": "sha256:<64 hex>, or empty to follow the tag"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1,
          "description": "never root"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretEnv": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "signingKey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "secretsKey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "trustedProxies": {
          "type": "string"
        },
        "shutdownDelaySeconds": {
          "type": "integer"
        },
        "shutdownGraceSeconds": {
          "type": "integer"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer"
        },
        "javaToolOptions": {
          "type": "string"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "initContainer": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observability": {
      "type": "object"
    },
    "monitoring": {
      "type": "object"
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$",
              "description": "sha256:<64 hex>, or empty to follow the tag"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "config": {
          "type": "object"
        }
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$",
              "description": "sha256:<64 hex>, or empty to follow the tag"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "env": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "description": "repository, tag, digest (the template checks the digest)"
        },
        "existingSecret": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^[^?]*$",
          "description": "no query string: the server refuses one at start (TLS: externalDatabase.tls, not ?sslmode=)"
        }
      }
    },
    "polis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "description": "repository, tag, digest (the template checks the digest)"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "cloudSessions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "runner": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$",
                  "description": "sha256:<64 hex>, or empty to follow the tag"
                }
              }
            }
          }
        },
        "allowedOrgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        },
        "cloudflareOriginPulls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egress": {
          "type": "object",
          "properties": {
            "deniedCidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraDeniedCidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ciliumEgressDeny": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": [
        "runAsNonRoot",
        "seccompProfile"
      ],
      "properties": {
        "runAsNonRoot": {
          "const": true,
          "description": "restricted: never root"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ],
              "description": "restricted: never Unconfined"
            }
          }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "required": [
        "allowPrivilegeEscalation",
        "readOnlyRootFilesystem",
        "capabilities"
      ],
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "readOnlyRootFilesystem": {
          "const": true
        },
        "privileged": {
          "const": false
        },
        "runAsNonRoot": {
          "const": true
        },
        "capabilities": {
          "type": "object",
          "required": [
            "drop"
          ],
          "properties": {
            "drop": {
              "type": "array",
              "contains": {
                "const": "ALL"
              }
            },
            "add": {
              "type": "array",
              "items": {
                "const": "NET_BIND_SERVICE"
              },
              "description": "restricted allows NET_BIND_SERVICE only"
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ]
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        }
      }
    }
  }
}
